{
	"name": "pi-agents-guard",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Mechanical enforcement for AGENTS.md MUST rules that permission systems cannot cover",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
